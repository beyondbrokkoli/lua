# /home/halim/lua/.gdbinit.agent — thin shim: the AGENT face of gdb/glm.gdbinit.
#
# Load INSTEAD of the human config (never both):
#   cd ~/lua
#   rust-gdb -nx -x .gdbinit.agent --args ./target/debug/glm --debug cases/<case>.lua <args...>
# -nx suppresses ~/.gdbinit AND ./.gdbinit (the human shim); rust-gdb's own
# injected pretty-printer -x still loads. CWD must be ~/lua — the host resolves
# ./libglm_out.so, out.ll, and the trace plates relative to it.
#
# Design contract (the agent face of the one core — see gdb/glm.gdbinit):
#   * Stops are fully silent — gdb already echoes `file:line` + the source text
#     on every breakpoint hit and step, which is the only per-stop context an
#     agent needs. No borders, no ANSI, no register dashboard, no hook-stop
#     output. Everything else is on-demand via the dense commands the core
#     defines; each command prints exactly one line (or one line per
#     cell/frame), no decoration.
#
# Smoke: ./gdb/smoke.sh --face agent

set $glm_face_human = 0
source gdb/glm.gdbinit

# --- agent-only output discipline (the human shim sets the pretty forms) --
set print pretty off
set print array off
set print elements 24
set print repeats unlimited
